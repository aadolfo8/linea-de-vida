generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum OAuthConnectionStatus {
 ACTIVE
 REVOKED
 REVOCATION_PENDING
 ERROR
}
enum PhotoSourceStatus {
 ACTIVE
 PAUSED
 DISCONNECTED
}
enum PhotoSourceType {
  GENERIC
  GOOGLE_TAKEOUT
}
enum TakeoutMatchStatus {
  NOT_APPLICABLE
  TAKEOUT_MATCHED
  TAKEOUT_NOT_FOUND
  TAKEOUT_AMBIGUOUS
}
enum SyncRunStatus {
 QUEUED
 RUNNING
 SUCCEEDED
 PARTIAL
 FAILED
 CANCELLED
}
enum SyncPhase {
  SCANNING
  PROCESSING
}
enum SyncMode {
 INITIAL
 INCREMENTAL
 MANUAL
}
enum PhotoStatus {
 ACTIVE
 MISSING
 UNSUPPORTED
 ACCESS_DENIED
}
enum PhotoFileStatus {
 ACTIVE
 MISSING
}
enum IndexedFolderStatus {
 ACTIVE
 MISSING
}
enum DatePrecision {
 DAY
 MONTH
 YEAR
 UNKNOWN
}
enum DateSource {
  EXIF
  DRIVE_IMAGE_METADATA
  TAKEOUT
  FILENAME
  FOLDER
  FOLDER_RULE
  MANUAL
  NONE
}
enum FolderDateRuleScope {
  FALLBACK_DESCENDANTS
  ALL_DESCENDANTS
  DIRECT_ONLY
}
enum SyncIssueCode {
 RATE_LIMITED
 DRIVE_UNAVAILABLE
 ACCESS_DENIED
  INVALID_TAKEOUT_JSON
  AMBIGUOUS_TAKEOUT_MATCH
 UNREADABLE_METADATA
 UNSUPPORTED_MEDIA
 LIMIT_REACHED
 UNKNOWN
}
enum SyncIssueSeverity {
 INFO
 WARNING
 ERROR
}
model User {
 id String @id @default(cuid())
 googleSubject String? @unique
 email String @unique
 displayName String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 connections OAuthConnection[]
 sources PhotoSource[]
 photos Photo[]
 photoFiles PhotoFile[]
 indexedFolders IndexedFolder[]
 photoExclusions PhotoExclusion[]
}
model OAuthConnection {
 id String @id @default(cuid())
 userId String
 provider String
 googleAccountId String
 grantedScopes String[]
 refreshTokenCiphertext String?
 status OAuthConnectionStatus @default(ACTIVE)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 sources PhotoSource[]
 @@unique([userId,provider,googleAccountId])
}
model OAuthState {
 id String @id
 purpose String
 userId String?
 codeVerifier String
 expiresAt DateTime
 createdAt DateTime @default(now())
 @@index([expiresAt])
}
model PhotoSource {
 id String @id @default(cuid())
 userId String
 oauthConnectionId String
 driveFolderId String
  name String
  type PhotoSourceType @default(GENERIC)
 status PhotoSourceStatus @default(ACTIVE)
 lastCursor String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 connection OAuthConnection @relation(fields:[oauthConnectionId],references:[id])
 runs SyncRun[]
 photos Photo[]
 files PhotoFile[]
 indexedFolders IndexedFolder[]
 @@unique([userId,driveFolderId])
 @@index([userId,status])
}
model SyncRun {
 id String @id @default(cuid())
 photoSourceId String
 status SyncRunStatus @default(QUEUED)
 mode SyncMode @default(MANUAL)
 cursorStartedAt String?
  cursorCompletedAt String?
  checkpoint Json?
  phase SyncPhase @default(SCANNING)
  foundCount Int @default(0)
  processedCount Int @default(0)
  scannedCount Int @default(0)
  indexedCount Int @default(0)
  issueCount Int @default(0)
  removedCount Int @default(0)
  createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 source PhotoSource @relation(fields:[photoSourceId],references:[id],onDelete:Cascade)
 issues SyncIssue[]
 @@index([photoSourceId,createdAt(sort:Desc)])
 @@index([status,createdAt])
}
model SyncIssue {
  id String @id @default(cuid())
  syncRunId String
  driveFileId String?
  driveFolderId String?
  code SyncIssueCode
  severity SyncIssueSeverity
  details String
  resolvedAt DateTime?
  createdAt DateTime @default(now())
 run SyncRun @relation(fields:[syncRunId],references:[id],onDelete:Cascade)
  @@index([syncRunId,severity])
  @@index([driveFileId])
  @@index([driveFolderId])
  @@index([resolvedAt,syncRunId])
}
/// One archive photo. `driveFileId`, `sourceId`, `folderId`, `fileName`, `mimeType` and
/// `lastSeenSyncRunId` are a denormalised projection of the preferred (primary) copy in
/// `files`; `PhotoFile` is the source of truth for every Drive copy of the same content.
model Photo {
 id String @id @default(cuid())
 userId String
 /// Content identity per user: `md5:<md5Checksum>:<size>`, or `drive:<fileId>` when Drive gave no checksum.
 contentKey String
 driveFileId String
 sourceId String
 folderId String?
 fileName String
 mimeType String
  status PhotoStatus @default(ACTIVE)
  lastSeenSyncRunId String?
  imageMetadata Json?
  takeoutMatchStatus TakeoutMatchStatus @default(NOT_APPLICABLE)
  takeoutMatchReason String?
  gpsLatitude Float?
  gpsLongitude Float?
 /// Soft hide: a hidden photo keeps its row, dates and copies but leaves the timeline, counts and search.
 hiddenAt DateTime?
 detectedDate DateTime? @db.Date
 detectedPrecision DatePrecision @default(UNKNOWN)
 detectedSource DateSource @default(NONE)
  effectiveDateValue DateTime? @db.Date
  effectiveDatePrecision DatePrecision @default(UNKNOWN)
  effectiveDateSource DateSource @default(NONE)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 source PhotoSource @relation(fields:[sourceId],references:[id])
 folder IndexedFolder? @relation(fields:[folderId],references:[id],onDelete:SetNull)
 override ManualDateOverride?
 files PhotoFile[]
 @@unique([userId,contentKey])
 @@index([userId,driveFileId])
 @@index([userId,status])
 @@index([userId,status,hiddenAt])
  @@index([sourceId,status])
  @@index([sourceId,lastSeenSyncRunId])
  @@index([folderId,status])
 @@index([userId,effectiveDateValue,effectiveDatePrecision])
}
/// One Drive file holding the bytes of a Photo. A photo can have several copies (a re-extracted
/// Takeout export, the same picture in another source); it stays available while one is ACTIVE.
model PhotoFile {
 id String @id @default(cuid())
 photoId String
 userId String
 sourceId String
 driveFileId String
 folderId String?
 fileName String
 mimeType String
 md5Checksum String?
 sizeBytes BigInt?
 status PhotoFileStatus @default(ACTIVE)
 lastSeenSyncRunId String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 photo Photo @relation(fields:[photoId],references:[id],onDelete:Cascade)
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 source PhotoSource @relation(fields:[sourceId],references:[id],onDelete:Cascade)
 folder IndexedFolder? @relation(fields:[folderId],references:[id],onDelete:SetNull)
 @@unique([userId,driveFileId])
 @@index([photoId,status])
 @@index([sourceId,status])
 @@index([sourceId,lastSeenSyncRunId])
 @@index([folderId])
}
model IndexedFolder {
 id String @id @default(cuid())
 userId String
 sourceId String
 driveFolderId String
 parentId String?
 name String
 path String[]
 status IndexedFolderStatus @default(ACTIVE)
 lastSeenSyncRunId String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 source PhotoSource @relation(fields:[sourceId],references:[id],onDelete:Cascade)
 parent IndexedFolder? @relation("FolderTree",fields:[parentId],references:[id],onDelete:SetNull)
  children IndexedFolder[] @relation("FolderTree")
  photos Photo[]
  files PhotoFile[]
  dateRule FolderDateRule?
 @@unique([userId,driveFolderId])
 @@index([sourceId,status])
 @@index([parentId,status])
 @@index([sourceId,lastSeenSyncRunId])
}
model FolderDateRule {
  id String @id @default(cuid())
  folderId String @unique
  dateValue DateTime @db.Date
  precision DatePrecision
  scope FolderDateRuleScope
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  folder IndexedFolder @relation(fields:[folderId],references:[id],onDelete:Cascade)
}
model PhotoExclusion {
 id String @id @default(cuid())
 userId String
 driveFileId String
 /// Content identity of the removed photo, so a new copy of the same bytes stays excluded.
 contentKey String?
 sourceId String?
 sourceName String?
 folderPath String[] @default([])
 fileName String?
 mimeType String?
 manualDateValue DateTime? @db.Date
 manualDatePrecision DatePrecision?
 manualDateReason String?
 restoredAt DateTime?
 createdAt DateTime @default(now())
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@unique([userId,driveFileId])
 @@index([userId,contentKey])
 @@index([userId,createdAt])
}
model ManualDateOverride {
 id String @id @default(cuid())
 photoId String @unique
 dateValue DateTime @db.Date
 precision DatePrecision
 reason String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 photo Photo @relation(fields:[photoId],references:[id],onDelete:Cascade)
}
