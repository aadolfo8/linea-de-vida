{
  "name": "@linea-de-vida/api",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/with-local-env.cjs node ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "build": "node ../../scripts/with-local-env.cjs node ./node_modules/prisma/build/index.js generate && nest build",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:migrate": "node ../../scripts/with-local-env.cjs node ./node_modules/prisma/build/index.js migrate dev",
    "prisma:deploy": "node ../../scripts/with-local-env.cjs node ./node_modules/prisma/build/index.js migrate deploy"
  },
  "dependencies": {
    "@googleapis/drive": "^10.0.0",
    "@googleapis/oauth2": "^1.0.7",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "^6.4.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "google-auth-library": "^9.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@nestjs/cli": "^11.0.5",
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.20.1",
    "prisma": "^6.4.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
