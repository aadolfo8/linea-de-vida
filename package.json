{
  "name": "linea-de-vida",
  "private": true,
  "scripts": {
    "dev": "node scripts/with-local-env.cjs pnpm --parallel --filter @linea-de-vida/web --filter @linea-de-vida/api dev",
    "dev:services": "pnpm --parallel --filter @linea-de-vida/web --filter @linea-de-vida/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "^0.64.0",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@9.15.4"
}
