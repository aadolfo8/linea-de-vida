# Host port exposed by Docker; PostgreSQL remains on 5432 inside Docker.
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://linea:linea@localhost:5433/linea_de_vida?schema=public
API_PORT=3001
API_ORIGIN=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
# Comma-separated browser origins. In production they must all be HTTPS origins.
ALLOWED_WEB_ORIGINS=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3001/v1/auth/google/callback
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3001/v1/oauth/google/drive/callback
SYNC_IMAGE_LIMIT=100
# In-memory, private thumbnail cache. Keep false locally to disable it entirely.
MEDIA_THUMBNAIL_CACHE_ENABLED=false
MEDIA_THUMBNAIL_CACHE_TTL_MS=60000
MEDIA_THUMBNAIL_CACHE_MAX_BYTES=1048576
MEDIA_THUMBNAIL_CACHE_MAX_ENTRIES=100
MEDIA_PROXY_TIMEOUT_MS=20000
# HTTP abuse controls. Limits are per signed user when present, otherwise per client IP.
REQUEST_BODY_LIMIT=32kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_MUTATION_MAX=30
# Required in production; protects GET /v1/metrics with Bearer authentication.
METRICS_TOKEN=replace-with-at-least-32-random-characters
# Sync metadata only: terminal runs after 90 days and issues after 30 days.
SYNC_ISSUE_RETENTION_DAYS=30
SYNC_RUN_RETENTION_DAYS=90
