# Copy to .env on the VPS. Replace every placeholder with a unique secret or deployment value.
NODE_ENV=production

# Public TLS configuration. Use the public DNS name and an operations mailbox on the VPS only.
PUBLIC_DOMAIN=example.invalid
LETSENCRYPT_EMAIL=ops@example.invalid
# Start at 0. Increase only after HTTPS has been verified in production.
HSTS_MAX_AGE=0

# PostgreSQL is private to the Compose network. Keep these values synchronized with DATABASE_URL.
POSTGRES_DB=linea_de_vida
POSTGRES_USER=linea
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://linea:replace-with-a-long-random-database-password@postgres:5432/linea_de_vida?schema=public

# Redis is private to the Compose network.
REDIS_URL=redis://redis:6379

# Replace example.invalid with the real HTTPS public origin before deployment.
API_PORT=3001
API_ORIGIN=https://example.invalid
WEB_ORIGIN=https://example.invalid
ALLOWED_WEB_ORIGINS=https://example.invalid

SESSION_SECRET=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
METRICS_TOKEN=replace-with-at-least-32-random-characters

GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_LOGIN_REDIRECT_URI=https://example.invalid/v1/auth/google/callback
GOOGLE_DRIVE_REDIRECT_URI=https://example.invalid/v1/oauth/google/drive/callback

SYNC_CONCURRENCY=5
SYNC_MAX_PENDING_FOLDERS=10000
SYNC_ITEM_CONCURRENCY=5
MEDIA_THUMBNAIL_CACHE_ENABLED=true
MEDIA_THUMBNAIL_CACHE_TTL_MS=60000
MEDIA_THUMBNAIL_CACHE_MAX_BYTES=1048576
MEDIA_THUMBNAIL_CACHE_MAX_ENTRIES=100
MEDIA_PROXY_TIMEOUT_MS=20000
REQUEST_BODY_LIMIT=32kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_MUTATION_MAX=30
SYNC_ISSUE_RETENTION_DAYS=30
SYNC_RUN_RETENTION_DAYS=90
